# =============================================================================
# templates/vaultwarden/.env.example — Vaultwarden environment variables
#
# IMPORTANT: Copy this file as '.env' and customize it.
#            Never check '.env' into the repo!
# =============================================================================

# --- Domain ---
# URL at which Vaultwarden is reachable.
# For local-only use: http://localhost:8080
# With Caddy/HTTPS: https://vault.example.tld
DOMAIN=http://localhost:8080

# --- Admin token ---
# SECURITY: Must be an Argon2 hash, not plaintext.
# Generate:
#   docker run --rm vaultwarden/server vaultwarden hash --preset owasp
#   → outputs: $argon2id$v=19$m=65540,t=3,p=4$...
#
# Quick start (local only, no server deployment):
#   openssl rand -base64 32   → set as ADMIN_TOKEN (plaintext)
#   Warning: plaintext is insecure when exposed over the network.
ADMIN_TOKEN=INSERT_ARGON2_HASH_HERE

# --- Registration ---
# true = new accounts allowed (initial setup only!)
# Set to false after creating the first account.
SIGNUPS_ALLOWED=true
