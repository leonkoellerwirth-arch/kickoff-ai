# =============================================================================
# ~/.zshrc — Interactive shell configuration (rewrite)
#
# Structure:
#   1. Powerlevel10k Instant Prompt (must come first)
#   2. oh-my-zsh + Theme + Plugins
#   3. PATH (built once, deduplicated via typeset -U)
#   4. Java / build tools
#   5. Node (nvm — lazy-loaded)
#   6. Python (conda — lazy-loaded, opt-in)
#   7. pnpm, bun, deno
#   8. AI tools
#   9. Aliases
#  10. Functions
#  11. Completions
#  12. Machine-specific overrides (from ~/.zshrc.local)
#
# Tokens, API keys, private aliases → ~/.zshrc.local (not in repo)
# =============================================================================

# =============================================================================
# 1. Powerlevel10k Instant Prompt
#    Must come BEFORE everything else (incl. oh-my-zsh)
# =============================================================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =============================================================================
# 2. oh-my-zsh
# =============================================================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
    web-search
)

source "$ZSH/oh-my-zsh.sh"

# =============================================================================
# 3. PATH — built once, then deduplicated
#
#    Order (higher = higher precedence):
#    1. ~/dev/base/bin  (paved-road CLI)
#    2. ~/.local/bin    (uv, claude, pipx tools)
#    3. ~/.bun/bin      (bun CLI)
#    4. ~/Library/pnpm  (pnpm global)
#    5. nvm Node bin    (current Node default)
#    6. /opt/homebrew   (already set via zprofile)
#    7. /usr/local/bin  (brew legacy / other tools)
#    8. System paths    (already set via zprofile)
#
#    typeset -U deduplicates automatically
# =============================================================================
typeset -U path

# paved-road CLI
path=("$HOME/dev/base/bin" $path)

# uv / pipx / Claude Code
path=("$HOME/.local/bin" $path)

# bun
export BUN_INSTALL="$HOME/.bun"
path=("$BUN_INSTALL/bin" $path)

# pnpm global
export PNPM_HOME="$HOME/Library/pnpm"
path=("$PNPM_HOME" $path)

# nvm: current default Node bin path
# (Fallback only — nvm shell integration lazy-loads the rest)
NVM_DEFAULT_ALIAS="$HOME/.nvm/alias/default"
if [ -f "$NVM_DEFAULT_ALIAS" ]; then
    NVM_DEFAULT_VERSION=$(cat "$NVM_DEFAULT_ALIAS")
    NVM_NODE_BIN="$HOME/.nvm/versions/node/${NVM_DEFAULT_VERSION}/bin"
    if [ -d "$NVM_NODE_BIN" ]; then
        path=("$NVM_NODE_BIN" $path)
    fi
fi

# /usr/local/bin (for older or x86 tools)
path=("/usr/local/bin" $path)

export PATH

# =============================================================================
# 4. Java / build tools
# =============================================================================

# Java 17 (OpenJDK via Homebrew)
if /usr/libexec/java_home -v 17 >/dev/null 2>&1; then
    export JAVA_HOME=$(/usr/libexec/java_home -v 17)
fi

# Maven comes from Homebrew — no M2_HOME needed
# (The old M2_HOME=$HOME/dev/maven was wrong and has been removed)

# =============================================================================
# 5. Node / nvm — LAZY LOAD
#
#    nvm is slow at startup. Load it only when 'nvm', 'node',
#    'npm' or 'npx' are invoked. The nvm Node bin path is already
#    in PATH above (fast access to the current default).
# =============================================================================
export NVM_DIR="$HOME/.nvm"

# Lazy loader for nvm
_nvm_lazy_load() {
    unfunction nvm node npm npx yarn 2>/dev/null || true
    [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && source "$NVM_DIR/bash_completion"
}

if [ -s "$NVM_DIR/nvm.sh" ]; then
    nvm()  { _nvm_lazy_load; nvm "$@"; }
    node() { _nvm_lazy_load; node "$@"; }
    npm()  { _nvm_lazy_load; npm "$@"; }
    npx()  { _nvm_lazy_load; npx "$@"; }
    yarn() { _nvm_lazy_load; yarn "$@"; }
fi

# =============================================================================
# 6. Python / conda — LAZY LOAD (opt-in)
#
#    Miniforge/conda is optional and only loaded when explicitly
#    called with 'conda activate' or 'conda'. This prevents
#    conda-base from overriding the system python3.
#    For new projects: use uv (no Conda needed).
# =============================================================================
_conda_lazy_load() {
    unfunction conda 2>/dev/null || true
    local MINIFORGE_DIR="$HOME/miniforge3"
    if [ -f "$MINIFORGE_DIR/bin/conda" ]; then
        __conda_setup="$("$MINIFORGE_DIR/bin/conda" 'shell.zsh' 'hook' 2>/dev/null)"
        if [ $? -eq 0 ]; then
            eval "$__conda_setup"
        fi
        unset __conda_setup
    fi
}

if [ -d "$HOME/miniforge3" ]; then
    conda() { _conda_lazy_load; conda "$@"; }
fi

# =============================================================================
# 7. pnpm / bun / deno — Completions
# =============================================================================

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# =============================================================================
# 8. AI tools
# =============================================================================

# claude-mem plugin (if installed)
# The binary is in ~/.claude/plugins and is managed by the plugin
# No path hardcoding needed — claude handles it

# AI subagent model configuration → ~/.zshrc.local
# (Personal setting, not in repo)
# Example: export CLAUDE_CODE_SUBAGENT_MODEL="claude-sonnet-4-6"

# =============================================================================
# 9. Aliases
# =============================================================================

# --- Git ---
alias gac='git add . && git commit -m'
# (More Git aliases are defined in ~/.gitconfig)

# --- Development ---
alias img-opt='~/dev/scripts/media-tools.sh compress'
alias img-resize='~/dev/scripts/media-tools.sh resize'

# --- Navigation ---
alias dev='cd ~/dev'

# =============================================================================
# 10. Functions
# =============================================================================

# Colored log tailing
# Usage: tail_logs <logfile>
function tail_logs() {
    if [ -z "${1:-}" ]; then
        echo "Usage: tail_logs <logfile>"
        return 1
    fi
    tail -f "$1" | awk '
    /ERROR/ {print "\033[1;31m" $0 "\033[0m"; next}
    /DEBUG/ {print "\033[1;30m" $0 "\033[0m"; next}
    /INFO/  {print "\033[1;32m" $0 "\033[0m"; next}
            {print "\033[0;37m" $0 "\033[0m"}'
}
alias taillogs='tail_logs'

# =============================================================================
# 11. Completions
# =============================================================================

# Docker CLI completions
if [ -d "$HOME/.docker/completions" ]; then
    fpath=("$HOME/.docker/completions" $fpath)
fi

# OpenClaw completion removed (OpenClaw uninstalled)
# ng completion removed (Angular CLI not installed)

# compinit — once, cached
autoload -Uz compinit
# Regenerate only daily (speeds up shell startup)
if [ $(date +'%j') != $(stat -f '%Sm' -t '%j' "${ZDOTDIR:-$HOME}/.zcompdump" 2>/dev/null || echo 0) ]; then
    compinit
else
    compinit -C
fi

# Load Powerlevel10k theme
[[ ! -f "$HOME/.p10k.zsh" ]] || source "$HOME/.p10k.zsh"

# =============================================================================
# 12. Machine-specific overrides
#
#    ~/.zshrc.local holds personal settings that do NOT belong in the repo:
#    - API keys / tokens (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...)
#    - CLAUDE_CODE_SUBAGENT_MODEL
#    - Private aliases
#    - OpenClaw replacement or other local tools
#    - Machine-specific PATH extensions
# =============================================================================
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
