#!/usr/bin/env bash
# =============================================================================
# automation/bin/secret-sweep — Scan for secrets and .env files
#
# Problem:    gitleaks is installed but runs without a hook (gap analysis A.7).
#             .pre-commit-config.yaml exists in base, but pre-commit is not
#             installed (gap analysis A.7). .env files sit in plaintext,
#             at least one outside of a repository (gap analysis B.1).
# Does:       Runs `gitleaks detect` over all repos under ~/dev/.
#             Finds all .env* files (including outside repos), checks whether
#             they are gitignored and whether they appear in the git history.
#             Writes report to local/secret-sweep.md.
#             Subcommand 'install-hooks': installs pre-commit in all repos
#             that have a .pre-commit-config.yaml.
# Changes:    Nothing (read-only) — except 'install-hooks' (installs hooks).
# Usage:      secret-sweep [--dry-run] [--help]
#             secret-sweep install-hooks [--dry-run]
# =============================================================================
set -euo pipefail

AUTOMATION_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$AUTOMATION_DIR/lib-automation.sh"

# =============================================================================
# Argument-Parsing
# =============================================================================
SUBCOMMAND=""
TIMEOUT_SECS=120  # Timeout per repo for gitleaks

for arg in "$@"; do
    case "$arg" in
        install-hooks) SUBCOMMAND="install-hooks" ;;
        --dry-run)     DRY_RUN=1 ;;
        --help|-h)
            cat >&2 <<'EOF'
Usage: secret-sweep [--dry-run] [--help]
       secret-sweep install-hooks [--dry-run]

  Scans all repos under ~/dev/ for secrets and .env files.

Options:
  --dry-run         Show what would be checked (install-hooks: no installing)
  --help            This help

Subcommands:
  install-hooks     Install pre-commit in all repos with .pre-commit-config.yaml.
                    Installs the pre-commit tool (via uv or pipx) if not present.

Output: local/secret-sweep.md (gitignored)

Examples:
  secret-sweep                    # Full scan
  secret-sweep --dry-run          # Only show what would be checked
  secret-sweep install-hooks      # Set up pre-commit in all matching repos
EOF
            exit 0
            ;;
        *)
            err "Unknown option: $arg (--help for help)"
            ;;
    esac
done

# =============================================================================
# Subcommand: install-hooks
# =============================================================================
if [ "$SUBCOMMAND" = "install-hooks" ]; then
    step "Installing pre-commit in repos"

    # Install pre-commit if not present
    if ! have pre-commit; then
        warn "pre-commit not installed."
        if have uv; then
            info "Installing pre-commit via uv tool install..."
            run uv tool install pre-commit
        elif have pipx; then
            info "Installing pre-commit via pipx..."
            run pipx install pre-commit
        elif have brew; then
            info "Installing pre-commit via brew..."
            run brew install pre-commit
        else
            err "Neither uv, pipx, nor brew available. Install pre-commit manually."
        fi
    fi

    if ! have pre-commit; then
        err "pre-commit could not be installed."
    fi

    ok "pre-commit $(pre-commit --version 2>/dev/null) available."

    # Install in all repos with .pre-commit-config.yaml
    installed=0
    skipped=0
    for d in "$DEV_DIR"/*/; do
        [ -d "$d/.git" ] || continue
        [ -f "$d/.pre-commit-config.yaml" ] || continue
        name=$(basename "$d")

        if [ "$DRY_RUN" = "1" ]; then
            info "[dry-run] Would install: pre-commit install in $name"
            skipped=$((skipped + 1))
        else
            info "Installing pre-commit in: $name"
            if (cd "$d" && pre-commit install --install-hooks 2>&1); then
                ok "  $name: pre-commit hooks installed"
                installed=$((installed + 1))
            else
                warn "  $name: pre-commit install failed"
                skipped=$((skipped + 1))
            fi
        fi
    done
    info "$installed repos configured, $skipped skipped."
    exit 0
fi

# =============================================================================
# Main scan
# =============================================================================
step "=== secret-sweep ==="

if ! have gitleaks; then
    err "gitleaks not installed. Install with: brew install gitleaks"
fi

ensure_local_dir
REPORT="$LOCAL_DIR/secret-sweep.md"
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

{
    printf "# Secret-Sweep — %s\n\n" "$TIMESTAMP"
    printf "**Tool:** gitleaks %s  \n" "$(gitleaks version 2>/dev/null || echo '?')"
    printf "**Repos gescannt:** %s/  \n\n" "$DEV_DIR"
} > "$REPORT"

FINDINGS=0
ENV_FINDINGS=0
HISTORY_FINDINGS=0
REPOS_SCANNED=0

# =============================================================================
# 1. gitleaks over all repos
# =============================================================================
step "Step 1/3: gitleaks scan over all repos"
printf "## gitleaks Scan\n\n" >> "$REPORT"

for d in "$DEV_DIR"/*/; do
    [ -d "$d/.git" ] || continue
    name=$(basename "$d")
    REPOS_SCANNED=$((REPOS_SCANNED + 1))

    printf "  Scanne: %-35s" "$name" >&2

    if [ "$DRY_RUN" = "1" ]; then
        printf " [dry-run]\n" >&2
        continue
    fi

    # gitleaks: staged + committed, with timeout
    result=$(timeout "$TIMEOUT_SECS" gitleaks detect --source "$d" --no-git \
        --exit-code 0 --report-format json --report-path /dev/stdout 2>/dev/null || true)

    # Alternative: git history scan
    history_result=$(timeout "$TIMEOUT_SECS" gitleaks detect --source "$d" \
        --exit-code 0 --report-format json --report-path /dev/stdout 2>/dev/null || true)

    if [ -n "$result" ] && printf '%s' "$result" | grep -q '"RuleID"'; then
        finding_count=$(printf '%s\n' "$result" | grep -c '"RuleID"' || echo "0")
        printf " FINDING: %s match(es)\n" "$finding_count" >&2
        warn "FINDING in $name: $finding_count match(es)"
        FINDINGS=$((FINDINGS + finding_count))
        printf "### %s — %s match(es) (working directory)\n\n" "$name" "$finding_count" >> "$REPORT"
        printf '%s\n' "$result" | grep '"RuleID"\|"Secret"\|"File"\|"Match"' | \
            sed 's/^/    /' >> "$REPORT" 2>/dev/null || true
        printf "\n" >> "$REPORT"
    elif [ -n "$history_result" ] && printf '%s' "$history_result" | grep -q '"RuleID"'; then
        hist_count=$(printf '%s\n' "$history_result" | grep -c '"RuleID"' || echo "0")
        printf " HISTORY FINDING: %s\n" "$hist_count" >&2
        warn "CRITICAL: secret in git history of $name ($hist_count match(es))"
        HISTORY_FINDINGS=$((HISTORY_FINDINGS + hist_count))
        printf "### %s — CRITICAL: %s match(es) in git history\n\n" "$name" "$hist_count" >> "$REPORT"
        printf '%s\n' "$history_result" | grep '"RuleID"\|"Secret"\|"File"\|"Match"\|"Commit"' | \
            sed 's/^/    /' >> "$REPORT" 2>/dev/null || true
        printf "\n" >> "$REPORT"
    else
        printf " ok\n" >&2
    fi
done

if [ "$DRY_RUN" = "0" ]; then
    info "$REPOS_SCANNED repos scanned."
fi

# =============================================================================
# 2. Find .env* files (including outside repos)
# =============================================================================
step "Step 2/3: searching for .env files (including outside repos)"
printf "## .env-Dateien\n\n" >> "$REPORT"

# Search in $HOME/dev and directly in $HOME (one level)
while IFS= read -r env_file; do
    # .env.example and .env.template are OK
    case "$(basename "$env_file")" in
        .env.example|.env.template|.env.sample) continue ;;
    esac

    dir=$(dirname "$env_file")

    # Gitignored?
    gitignored="no"
    if git -C "$dir" check-ignore -q "$env_file" 2>/dev/null; then
        gitignored="yes"
    fi

    # Inside a git repo?
    in_repo="no"
    git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 && in_repo="yes"

    # Short relative path for display
    rel_path="${env_file#"$HOME/"}"

    if [ "$gitignored" = "no" ]; then
        warn ".env not gitignored: ~/$rel_path (in repo: $in_repo)"
        printf "- **~/%s** (gitignored: %s, in repo: %s)\n" \
            "$rel_path" "$gitignored" "$in_repo" >> "$REPORT"
        ENV_FINDINGS=$((ENV_FINDINGS + 1))
    else
        info ".env gitignored: ~/$rel_path"
        printf "- ~/%s (gitignored: yes, in repo: %s) ✓\n" "$rel_path" "$in_repo" >> "$REPORT"
    fi
done < <(find "$DEV_DIR" "$HOME" -maxdepth 2 -name ".env*" \
    -not -path "*/.git/*" \
    -not -path "*/node_modules/*" \
    -not -path "*/__pycache__/*" \
    2>/dev/null | sort -u || true)

printf "\n" >> "$REPORT"

# =============================================================================
# 3. Secrets in git history (critical)
# =============================================================================
step "Step 3/3: checking .env in git history"
printf "## .env in git history (critical)\n\n" >> "$REPORT"

for d in "$DEV_DIR"/*/; do
    [ -d "$d/.git" ] || continue
    name=$(basename "$d")

    if [ "$DRY_RUN" = "1" ]; then
        info "[dry-run] Would check git history of $name for .env"
        continue
    fi

    # Check whether .env files were ever committed
    env_in_history=$(git -C "$d" log --all --full-history -- "*.env" ".env" ".env.*" \
        --format="%h %s" 2>/dev/null | head -5 || true)
    if [ -n "$env_in_history" ]; then
        warn "CRITICAL: .env in git history of $name!"
        printf "### CRITICAL: %s — .env in git history\n\n" "$name" >> "$REPORT"
        printf '```\n%s\n```\n\n' "$env_in_history" >> "$REPORT"
        printf "**Fix:** use git-filter-repo or BFG Repo Cleaner, then force-push + rotate all secrets.\n\n" >> "$REPORT"
        HISTORY_FINDINGS=$((HISTORY_FINDINGS + 1))
    fi
done

# =============================================================================
# Summary
# =============================================================================
printf "\n" >&2
step "Results"
{
    printf "## Summary\n\n"
    printf "| Category | Count |\n"
    printf "|----------|-------|\n"
    printf "| Repos scanned | %d |\n" "$REPOS_SCANNED"
    printf "| gitleaks findings (working directory) | %d |\n" "$FINDINGS"
    printf "| .env not gitignored | %d |\n" "$ENV_FINDINGS"
    printf "| Secrets in git history | %d |\n" "$HISTORY_FINDINGS"
    printf "\n"
    if [ "$HISTORY_FINDINGS" -gt 0 ]; then
        printf "**CRITICAL:** Secrets found in git history! Rotate immediately and clean history.\n\n"
    fi
    if [ "$FINDINGS" -gt 0 ] || [ "$ENV_FINDINGS" -gt 0 ]; then
        printf "**Recommendation:** Use Vaultwarden + env-run (env-run migrate) and install pre-commit hooks (secret-sweep install-hooks).\n"
    fi
} >> "$REPORT"

if [ "$FINDINGS" -gt 0 ] || [ "$ENV_FINDINGS" -gt 0 ] || [ "$HISTORY_FINDINGS" -gt 0 ]; then
    warn "Findings detected — report: $REPORT"
    notify "secret-sweep: findings" "$FINDINGS gitleaks · $ENV_FINDINGS .env unprotected · $HISTORY_FINDINGS in history"
    exit 1
else
    ok "No critical findings. Report: $REPORT"
    notify "secret-sweep: no findings" "Scan complete."
fi
